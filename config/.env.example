# ── gen_suite environment ────────────────────────────────────────────────────
# Installation: copy this file to config/.env, fill in and run:
# docker compose --env-file config/.env up -d --build --wait
# Optional helper: ./install.sh --configure-only (Python on host); not required by Compose.
MICAPUM_STACK_NAME=gen_suite
TZ=Europe/Madrid
UID=1000
GID=1000

# ── Host directories (mapped, so all state is visible/back-up-able) ───────────
# DATA_DIR holds postgres/redis/(minio) data; CONFIG_DIR holds this .env + operator files.
DATA_DIR=./data
CONFIG_DIR=./config

# ── Postgres ──────────────────────────────────────────────────────────────
# Admin/owner role — used ONLY for migrations (and DB backups).
POSTGRES_DB=gensuite
POSTGRES_USER=gensuite
POSTGRES_PASSWORD=change-me-admin
# Restricted runtime role (NON-superuser, NOBYPASSRLS) created by the first migration.
APP_DB_USER=gensuite_app
APP_DB_PASSWORD=change-me-app

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080

# ── Runtime environment ──────────────────────────────────────────────────────
# IMPORTANT: set to "production" on any internet-exposed deploy. In production the app refuses to
# boot with placeholder secrets (validate_runtime_secrets); "development" skips that guard.
ENVIRONMENT=production
DEBUG=false
# Origins allowed by CORS (JSON list). With the bundled frontend (same origin via /api proxy)
# the default is fine; set your public URL when a separate origin calls the API.
# CORS_ORIGINS=["https://gensuite.example.com"]

# ── Auth / secrets ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
SUITE_MASTER_KEY=
# Leave false. Create the first admin locally with a hidden password prompt:
# docker compose --env-file config/.env run --rm --no-deps gen-suite-backend python -m app.bootstrap_admin
ALLOW_FIRST_USER_ADMIN=false
# Public production is invite-only. An operator approves access requests; SMTP sends
# a single-use link that also verifies the recipient address.
INVITATION_ONLY=true
FRONTEND_PUBLIC_URL=https://gensuite.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Gen Suite <noreply@gensuite.example.com>
SMTP_STARTTLS=true

# ── Object storage ───────────────────────────────────────────────────────────
# Default: a bundled MinIO container stores the library (PDFs, page images, photos) under DATA_DIR.
COMPOSE_PROFILES=bundled-storage
# PDF/A opcional: añade pdfa a los perfiles (bundled-storage,pdfa o pdfa con S3 externo).
# No necesita otro instalador: consulta docs/PDFA.md; conserva siempre los originales.
# PDFA_MAX_PAGES=1000
# PDFA_MAX_BYTES=2147483648
# Exportación del árbol en segundo plano (GEDCOM/GEDZIP). No equivale a backup.
# TREE_EXPORT_MAX_ROWS=100000
# TREE_EXPORT_MAX_GRAPH_BYTES=33554432
# TREE_EXPORT_MAX_FILES=10000
# TREE_EXPORT_MAX_BYTES=2147483648
# Importación revisada GEDCOM 7/GEDZIP. Original privado; no aplica automáticamente.
# TREE_IMPORT_MAX_BYTES=2147483648
# TREE_IMPORT_MAX_EXPANDED_BYTES=4294967296
# TREE_IMPORT_MAX_FILES=10000
# Sintaxis/proyección comparte TREE_EXPORT_MAX_ROWS y TREE_EXPORT_MAX_GRAPH_BYTES.
# Reserva además espacio temporal para el paquete completo; no subir estos límites
# sin dimensionar disco, RAM, tiempos y cuota S3 del worker.
# PDFA_TIMEOUT_SECONDS=1800
MINIO_ENDPOINT=gen-suite-minio:9000
MINIO_ACCESS_KEY=gensuite
MINIO_SECRET_KEY=change-me-minio
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_PRIVATE=gensuite-private
MINIO_BUCKET_PUBLIC=gensuite-public
# MINIO_ADDRESSING_STYLE=path   # set to "path" for MinIO/Backblaze if you hit addressing errors

# ── EXTERNAL S3 instead of the bundled MinIO (AWS / Backblaze / Wasabi) ───────
# Pre-create the two buckets, then UNCOMMENT these (and set COMPOSE_PROFILES= empty above so the
# bundled MinIO doesn't start). Example for AWS S3 in eu-west-1:
#   COMPOSE_PROFILES=
#   MINIO_ENDPOINT=s3.eu-west-1.amazonaws.com
#   MINIO_SECURE=true
#   MINIO_REGION=eu-west-1
#   MINIO_ACCESS_KEY=AKIA...
#   MINIO_SECRET_KEY=...
#   MINIO_BUCKET_PRIVATE=mi-gensuite-private
#   MINIO_BUCKET_PUBLIC=mi-gensuite-public
# Backblaze B2 example: MINIO_ENDPOINT=s3.us-west-002.backblazeb2.com, MINIO_ADDRESSING_STYLE=path

# ── Backups (Postgres → isolated S3 in the EU) ────────────────────────────────
# Use a separate account and bucket with versioning + Object Lock/lifecycle configured
# at the provider. The web application must not have permission to delete this bucket.
# The scheduled backup is DATABASE-ONLY. Full objects+database recovery is an operator
# command through compose.recovery.yaml; see docs/RECUPERACION_COMPLETA.md.
BACKUP_TO_S3=false
# Legacy retention hint: no local deletion; enforce and verify retention at the provider.
BACKUP_RETENTION=35
BACKUP_HOUR=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=eu-west-1
BACKUP_S3_SECURE=true
#BACKUP_S3_ADDRESSING_STYLE=path

# ── Connector gates (server-admin) ──────────────────────────────────────────
# FamilySearch is NOT permitted by FamilySearch; off by default.
FS_CONNECTOR_ENABLED=false
# Disabled by default until complete bidirectional validation against Gramps Desktop/Web.
GRAMPS_SYNC_ENABLED=false
# Public trees are unlisted, token-protected snapshots. Disable immediately during an incident.
PUBLIC_SHARING_ENABLED=true
# In public production, set false; development keeps docs enabled automatically.
API_DOCS_ENABLED=false
APP_VERSION=0.2.0

# ── Despliegue desde imágenes publicadas (compose.release.yaml) ───────────────
# Versión de las imágenes ghcr.io/borborborja/gen-suite-*: tag de release inmutable.
GEN_SUITE_VERSION=0.2.0

# ── Importaciones masivas reanudables ───────────────────────────────────────
# Cuota de admisión de originales nuevos por espacio (500 GiB). No es uso físico total:
# reservar espacio adicional para fragmentos, copias verificadas, PDF y backups.
# La limpieza explícita libera reservas de cargas nunca procesadas solo al terminar;
# no hay eliminación automática por antigüedad.
# Ajustes ofrece inventarios observacionales de versiones/copias/multipart (0047).
# Son independientes del recuento protegido de cuota: docs/INVENTARIO_ALMACENAMIENTO.md.
INGEST_TENANT_QUOTA_BYTES=536870912000
INGEST_MAX_FILES=100000
# Cuota de contenido S3 por espacio (1 TiB), originales + derivados + reservas (0048).
# Datos existentes requieren recuento protegido en Ajustes; no se consideran vacíos.
# No es capacidad física del disco: reservar margen para BD, réplicas y backups.
# Misma configuración en API/worker; no mezclar con escritores de versiones antiguas.
# Límites y operaciones inciertas: docs/CUOTA_ALMACENAMIENTO.md.
STORAGE_TENANT_QUOTA_BYTES=1099511627776
# Solo estos hosts pueden declararse motores locales sin reserva de pago. No añadas proxies
# de servicios facturados; evita modelos Ollama con ejecución delegada a la nube.
AI_LOCAL_ENDPOINT_HOSTS=localhost,127.0.0.1,::1,ollama,kraken-htr
