# ── gen_suite environment (copy to .env and fill in) ─────────────────────────
# Micapum stack identity
MICAPUM_STACK_NAME=gen_suite
TZ=Europe/Madrid
UID=1000
GID=1000

# ── Postgres ──────────────────────────────────────────────────────────────
# Admin/owner role — used ONLY for migrations.
POSTGRES_DB=gensuite
POSTGRES_USER=gensuite
POSTGRES_PASSWORD=change-me-admin
# Restricted runtime role (NON-superuser, NOBYPASSRLS) created by the first migration.
APP_DB_USER=gensuite_app
APP_DB_PASSWORD=change-me-app

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis

# ── Frontend ────────────────────────────────────────────────────────────────
# Host port where the app UI (nginx) is published by the generic compose.yaml.
FRONTEND_PORT=8080

# ── Auth / secrets ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
SUITE_MASTER_KEY=

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=gensuite
MINIO_SECRET_KEY=change-me-minio

# ── Connector gates (server-admin) ──────────────────────────────────────────
# FamilySearch is NOT permitted by FamilySearch; off by default.
FS_CONNECTOR_ENABLED=false
